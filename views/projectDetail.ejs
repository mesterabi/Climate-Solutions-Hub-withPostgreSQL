<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Climate Solutions</title>
    <link rel="stylesheet" href="/css/main.css" />
</head>
<body class="bg-base-300">
  <%- include('partials/navbar', {page: '/projectDetails'}) %>

    <div class="container mx-auto">
        <div class="hero bg-neutral-300 rounded-lg p-6">
            <div class="hero-content text-center">
              <div class="max-w-md">
                <h1 class="text-5xl font-bold"><%= project.title %></h1>
                <p class="py-6">Below, you will find detailed information about the project: <%= project.title %></p>
              </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 p-6">
            <div>
                <img src="<%= project.feature_img_url %>" class="rounded-lg w-full" />
            </div>
            <div class="prose">
                <p><%= project.intro_short %>
                    <br><br>
                    <span class="font-bold">Impact:</span><br><br>
                    <%= project.impact %>
                    <br><br>
                    <span class="font-bold">More Information: </span>
                    <a href="<%= project.original_source_url %>" target="_blank"><%= project.original_source_url %></a>
                    <br><br>
                    <span id="quote"></span><br>
                    <em id="author"></em><br><br>
                    <a href="/solutions/editProject/<%= project.id %>" class="btn btn-success mr-2">Edit</a>
                    <a href="#" onclick="history.back(); return false;" class="btn btn-neutral">Return</a>
                </p>
            </div>
        </div>
    </div>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            fetch('https://dummyjson.com/quotes/random')
            .then(response => response.json())
            .then(data => {
                document.getElementById('quote').textContent = `"${data.quote}"`;
                document.getElementById('author').textContent = `- ${data.author}`;
            })
        })
    </script>
</body>
</html>